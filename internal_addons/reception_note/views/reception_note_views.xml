<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ VISTAS PARA LAS LÍNEAS DE PESAJE ============ -->
    <!-- Vista lista (tree) de líneas de pesaje -->
    <record id="view_reception_note_line_tree" model="ir.ui.view">
        <field name="name">reception.note.line.tree</field>
        <field name="model">reception.note.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="product_id"/>
                <field name="gross_weight"/>
                <field name="tare_weight"/>
                <field name="net_weight" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- Vista formulario de líneas de pesaje -->
    <record id="view_reception_note_line_form" model="ir.ui.view">
        <field name="name">reception.note.line.form</field>
        <field name="model">reception.note.line</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="product_id"/>
                    <field name="gross_weight"/>
                    <field name="tare_weight"/>
                    <field name="net_weight" readonly="1"/>
                </group>
            </form>
        </field>
    </record>

    <!-- ============ VISTAS PARA EL RESUMEN POR MATERIAL ============ -->
    <!-- Vista lista (tree) del resumen -->
    <record id="view_reception_note_summary_tree" model="ir.ui.view">
        <field name="name">reception.note.summary.tree</field>
        <field name="model">reception.note.summary</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="product_id"/>
                <field name="subtotal_kg"/>
                <field name="discount_percent"/>
                <field name="discount_kg" readonly="1"/>
                <field name="total_kg" readonly="1"/>
                <field name="price_unit"/>
                <field name="amount" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- Vista formulario del resumen -->
    <record id="view_reception_note_summary_form" model="ir.ui.view">
        <field name="name">reception.note.summary.form</field>
        <field name="model">reception.note.summary</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="product_id"/>
                    <field name="subtotal_kg"/>
                    <field name="discount_percent"/>
                    <field name="discount_kg" readonly="1"/>
                    <field name="total_kg" readonly="1"/>
                    <field name="price_unit"/>
                    <field name="amount" readonly="1"/>
                </group>
            </form>
        </field>
    </record>

    <!-- ============ VISTA PRINCIPAL (FORMULARIO) ============ -->
    <record id="view_reception_note_form" model="ir.ui.view">
        <field name="name">reception.note.form</field>
        <field name="model">reception.note</field>
        <field name="arch" type="xml">
            <form string="Nota de Recepción">
                <header>
                    <button name="action_compute_summary" type="object"
                            string="Calcular Resumen" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_set_received" type="object"
                            string="Marcar Recibido" class="btn-secondary"
                            invisible="state != 'draft'"/>
                    <button name="action_generate_purchase_order" type="object"
                            string="Generar Orden de Compra" class="btn-primary"
                            invisible="state not in ['received', 'draft']"/>
                    <button name="action_set_facturado" type="object"
                            string="Marcar Facturado" class="btn-secondary"
                            invisible="state not in ['purchase_created', 'received']"/>
                    <button name="action_cancel" type="object"
                            string="Cancelar" class="btn-secondary"
                            invisible="state not in ['draft', 'received']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,received,purchase_created,facturado"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="supplier_ref"/>
                            <field name="entry_time"/>
                            <field name="exit_time"/>
                        </group>
                        <group>
                            <field name="purchase_order_id" readonly="1"/>
                            <field name="total_kg" readonly="1"/>
                            <field name="total_amount" readonly="1" widget="monetary"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Pesajes">
                            <field name="line_ids"
                                   mode="list,form"
                                   tree_view_id="view_reception_note_line_tree"
                                   form_view_id="view_reception_note_line_form"/>
                        </page>
                        <page string="Resumen">
                            <field name="summary_ids"
                                   mode="list,form"
                                   tree_view_id="view_reception_note_summary_tree"
                                   form_view_id="view_reception_note_summary_form"/>
                        </page>
                        <page string="Notas Internas">
                            <field name="note" placeholder="Agregue notas..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ VISTA LISTA (TREE) PRINCIPAL ============ -->
    <record id="view_reception_note_tree" model="ir.ui.view">
        <field name="name">reception.note.tree</field>
        <field name="model">reception.note</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="supplier_ref"/>
                <field name="entry_time"/>
                <field name="exit_time"/>
                <field name="state"/>
                <field name="total_kg" sum="Total Kg"/>
                <field name="total_amount" sum="Total a Pagar"/>
            </list>
        </field>
    </record>

    <!-- ============ ACCIÓN DE VENTANA ============ -->
    <record id="action_reception_note" model="ir.actions.act_window">
        <field name="name">Notas de Recepción</field>
        <field name="res_model">reception.note</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree una nueva nota de recepción
            </p>
        </field>
    </record>
</odoo>