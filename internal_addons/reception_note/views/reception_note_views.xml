<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ VISTAS PARA LAS LÍNEAS DE PESAJE ============ -->
    <!-- Vista lista (tree) de líneas de pesaje -->
    <record id="view_reception_note_line_tree" model="ir.ui.view">
        <field name="name">reception.note.line.tree</field>
        <field name="model">reception.note.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="product_id"/>
                <field name="gross_weight"/>
                <field name="tare_weight"/>
                <field name="net_weight" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- Vista formulario de líneas de pesaje -->
    <record id="view_reception_note_line_form" model="ir.ui.view">
        <field name="name">reception.note.line.form</field>
        <field name="model">reception.note.line</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="product_id"/>
                    <field name="gross_weight"/>
                    <field name="tare_weight"/>
                    <field name="net_weight" readonly="1"/>
                </group>
            </form>
        </field>
    </record>

        <!-- Vista kanban para líneas de pesaje (mejor para móvil) -->
    <record id="view_reception_note_line_kanban" model="ir.ui.view">
        <field name="name">reception.note.line.kanban</field>
        <field name="model">reception.note.line</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="product_id"/>
                <field name="gross_weight"/>
                <field name="tare_weight"/>
                <field name="net_weight"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="row">
                                <div class="col-8">
                                    <strong>
                                        <t t-esc="record.product_id.value"/>
                                    </strong>
                                </div>
                                <div class="col-4 text-end">
                                    <span class="badge text-bg-primary">
                                        <t t-esc="record.net_weight.value"/> kg
                                    </span>
                                </div>
                            </div>
                            <div class="row mt8">
                                <div class="col-6">
                                    <small class="text-muted">Bruto:</small>
                                    <span><t t-esc="record.gross_weight.value"/></span>
                                </div>
                                <div class="col-6 text-end">
                                    <small class="text-muted">Tara:</small>
                                    <span><t t-esc="record.tare_weight.value"/></span>
                                </div>
                            </div>
                            <div class="row mt4">
                                <div class="col-12">
                                    <small class="text-muted">Neto:</small>
                                    <strong><t t-esc="record.net_weight.value"/> kg</strong>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============ VISTAS PARA EL RESUMEN POR MATERIAL ============ -->
    <!-- Vista lista (tree) del resumen -->
    <record id="view_reception_note_summary_tree" model="ir.ui.view">
        <field name="name">reception.note.summary.tree</field>
        <field name="model">reception.note.summary</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="product_id"/>
                <field name="subtotal_kg"/>
                <field name="discount_percent"/>
                <field name="discount_kg" readonly="1"/>
                <field name="total_kg" readonly="1"/>
                <field name="price_unit"/>
                <field name="amount" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- Vista formulario del resumen -->
    <record id="view_reception_note_summary_form" model="ir.ui.view">
        <field name="name">reception.note.summary.form</field>
        <field name="model">reception.note.summary</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="product_id"/>
                    <field name="subtotal_kg"/>
                    <field name="discount_percent"/>
                    <field name="discount_kg" readonly="1"/>
                    <field name="total_kg" readonly="1"/>
                    <field name="price_unit"/>
                    <field name="amount" readonly="1"/>
                </group>
            </form>
        </field>
    </record>

     <!-- Vista kanban para resumen (mejor para móvil) -->
    <record id="view_reception_note_summary_kanban" model="ir.ui.view">
        <field name="name">reception.note.summary.kanban</field>
        <field name="model">reception.note.summary</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="product_id"/>
                <field name="subtotal_kg"/>
                <field name="discount_percent"/>
                <field name="discount_kg"/>
                <field name="total_kg"/>
                <field name="price_unit"/>
                <field name="amount"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="row">
                                <div class="col-8">
                                    <strong>
                                        <t t-esc="record.product_id.value"/>
                                    </strong>
                                </div>
                                <div class="col-4 text-end">
                                    <span class="badge text-bg-success">
                                        <t t-esc="record.total_kg.value"/> kg
                                    </span>
                                </div>
                            </div>
                            <div class="row mt8">
                                <div class="col-6">
                                    <small class="text-muted">Subtotal:</small>
                                    <span><t t-esc="record.subtotal_kg.value"/> kg</span>
                                </div>
                                <div class="col-6 text-end">
                                    <small class="text-muted">Desc:</small>
                                    <span><t t-esc="record.discount_percent.value"/>%</span>
                                </div>
                            </div>
                            <div class="row mt4">
                                <div class="col-6">
                                    <small class="text-muted">Precio:</small>
                                    <span>$<t t-esc="record.price_unit.value"/></span>
                                </div>
                                <div class="col-6 text-end">
                                    <small class="text-muted">Importe:</small>
                                    <strong>$<t t-esc="record.amount.value"/></strong>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============ VISTA PRINCIPAL (FORMULARIO) ============ -->
    <record id="view_reception_note_form" model="ir.ui.view">
        <field name="name">reception.note.form</field>
        <field name="model">reception.note</field>
        <field name="arch" type="xml">
            <form string="Nota de Recepción">
                <header>
                    <button name="action_compute_summary" type="object"
                            string="Calcular Resumen" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_set_received" type="object"
                            string="Marcar Recibido" class="btn-secondary"
                            invisible="state != 'draft'"/>
                    <button name="action_generate_purchase_order" type="object"
                            string="Generar Orden de Compra" class="btn-primary"
                            invisible="state not in ['received', 'draft']"/>
                    <button name="action_set_facturado" type="object"
                            string="Marcar Facturado" class="btn-secondary"
                            invisible="state not in ['purchase_created', 'received']"/>
                    <button name="action_cancel" type="object"
                            string="Cancelar" class="btn-secondary"
                            invisible="state not in ['draft', 'received']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,received,purchase_created,facturado"
                           statusbar_colors='{"draft": "blue", "received": "warning", "purchase_created": "success", "facturado": "success", "cancel": "danger"}'/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="supplier_ref"/>
                            <field name="entry_time"/>
                            <field name="exit_time"/>
                        </group>
                        <group>
                            <field name="purchase_order_id" readonly="1"/>
                            <field name="total_kg" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_amount" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Pesajes">
                            <field name="line_ids"
                                   mode="list,form"
                                   tree_view_id="view_reception_note_line_tree"
                                   form_view_id="view_reception_note_line_form"/>
                        </page>
                        <page string="Resumen">
                            <field name="summary_ids"
                                   mode="list,form"
                                   tree_view_id="view_reception_note_summary_tree"
                                   form_view_id="view_reception_note_summary_form"/>
                        </page>
                        <page string="Notas Internas">
                            <field name="note" placeholder="Agregue notas..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ VISTA LISTA (TREE) PRINCIPAL ============ -->
    <record id="view_reception_note_tree" model="ir.ui.view">
        <field name="name">reception.note.tree</field>
        <field name="model">reception.note</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'"
                  decoration-warning="state == 'received'"
                  decoration-success="state == 'purchase_created'"
                  decoration-muted="state == 'facturado'"
                  decoration-danger="state == 'cancel'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="supplier_ref"/>
                <field name="entry_time"/>
                <field name="exit_time"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" 
                       decoration-warning="state == 'received'" 
                       decoration-success="state == 'purchase_created'"
                       decoration-muted="state == 'facturado'"
                       decoration-danger="state == 'cancel'"/>
                <field name="total_kg" sum="Total Kg"/>
                <field name="total_amount" sum="Total a Pagar"/>
            </list>
        </field>
    </record>

    <!-- ============ ACCIÓN DE VENTANA ============ -->
    <record id="action_reception_note" model="ir.actions.act_window">
        <field name="name">Notas de Recepción</field>
        <field name="res_model">reception.note</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree una nueva nota de recepción
            </p>
        </field>
    </record>
</odoo>