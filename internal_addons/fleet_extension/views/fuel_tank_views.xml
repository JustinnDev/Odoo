<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ TANQUES DE COMBUSTIBLE ============ -->
    <!-- Vista lista -->
    <record id="view_fleet_extension_fuel_tank_tree" model="ir.ui.view">
        <field name="name">fleet.extension.fuel_tank.tree</field>
        <field name="model">fleet.extension.fuel_tank</field>
        <field name="arch" type="xml">
            <list>
                <field name="vehicle_id"/>
                <field name="current_fuel" readonly='1'/>
                <field name="capacity"/>
                <field name="product_id"/>
            </list>
        </field>
    </record>

    <!-- Vista formulario -->
    <record id="view_fleet_extension_fuel_tank_form" model="ir.ui.view">
        <field name="name">fleet.extension.fuel_tank.form</field>
        <field name="model">fleet.extension.fuel_tank</field>
        <field name="arch" type="xml">
            <form string="Tanque de Combustible">
                <header>
                    <button name="action_refuel" type="object"
                            string="Repostar" class="btn-primary"/>
                    <button name="action_consume" type="object"
                            string="Consumir" class="btn-secondary"/>
                    <button name="action_extract" type="object"
                            string="Extraer" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <label for="vehicle_id"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="product_id"/>
                            <field name="service_type_id"/>
                            <field name="consume_location_id"/>
                        </group>
                        <group>
                            <field name="capacity"/>
                            <field name="current_fuel"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista formulario del asistente de repostaje -->
    <record id="view_fleet_extension_fuel_wizard_form" model="ir.ui.view">
        <field name="name">fleet.extension.fuel.wizard.form</field>
        <field name="model">fleet.extension.fuel.wizard</field>
        <field name="arch" type="xml">
            <form string="Operación de Combustible">
                <group>
                    <field name="tank_id" invisible="1"/>
                    <field name="operation_type" invisible="1"/>
                    <field name="product_id" invisible="1"/>
                    <field name="consume_location_id" invisible="1"/>
                </group>
                <group string="Detalles de la Operación">
                    <group>
                        <field name="quantity" required="1"/>
                        <field name="inventory_consumption" invisible="operation_type == 'consume'"/>
                        <field name="current_fuel" readonly="1"/>
                        <field name="new_fuel_level" readonly="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirmar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="action_fleet_extension_fuel_tank" model="ir.actions.act_window">
        <field name="name">Tanques de Combustible</field>
        <field name="res_model">fleet.extension.fuel_tank</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree un nuevo tanque de combustible
            </p>
        </field>
    </record>
</odoo>