<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ UBICACIONES ============ -->
    <!-- Vista lista -->
    <record id="view_fleet_extension_location_tree" model="ir.ui.view">
        <field name="name">fleet.extension.location.tree</field>
        <field name="model">fleet.extension.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="address" optional="hide"/>
                <field name="gps_url" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Vista formulario -->
    <record id="view_fleet_extension_location_form" model="ir.ui.view">
        <field name="name">fleet.extension.location.form</field>
        <field name="model">fleet.extension.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="gps_url"/>
                        </group>
                    </group>
                    <group string="Dirección">
                        <field name="address"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="action_fleet_extension_location" model="ir.actions.act_window">
        <field name="name">Ubicaciones</field>
        <field name="res_model">fleet.extension.location</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree una nueva ubicación
            </p>
        </field>
    </record>
</odoo>